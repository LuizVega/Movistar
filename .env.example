# =========================================================
# CONFIGURACIÓN DE YARA AI - MOVISTAR PERÚ
# =========================================================

# Google Gemini API Key (obtener en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo de Gemini (Recomendado: gemini-1.5-flash o gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# Temperatura del modelo (0.1 para mínima variabilidad y 0% alucinaciones)
GEMINI_TEMPERATURE=0.1

# Base de datos SQLite local
MOVISTAR_DB_PATH=movistar_desafio2.db

# Puerto del servidor
PORT=8501
